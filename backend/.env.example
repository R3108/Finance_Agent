# Copy to backend/.env and fill in.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
# SQLite file location (relative to backend/)
DATABASE_PATH=data/finance.db
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Auth: set COOKIE_SECURE=true behind HTTPS
COOKIE_SECURE=false
SESSION_DAYS=30
# Demo sandboxes ("Try the demo") are deleted after this many days
DEMO_RETENTION_DAYS=7
# Public URL of the web app (links in emails + Google redirect URI)
APP_URL=http://localhost:3000

# Email (verification, password reset). Used only when SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set;
# otherwise emails are printed in the API console and saved to OUTBOX_DIR. Re-read from .env without a restart.
# Gmail: smtp.gmail.com / 587 / your Gmail address / a 16-char App Password (myaccount.google.com/apppasswords).
# Port 465 uses implicit TLS. Test with:  python -m app.mailer test you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# Defaults to "Ledgerly <SMTP_USER>". With Gmail it must be your address or a verified "Send mail as" alias.
EMAIL_FROM=
OUTBOX_DIR=data/outbox

# Uploaded receipt files (relative to backend/). Point at a mounted volume before running more
# than one API replica, or receipts will only exist on whichever box handled the upload.
RECEIPTS_DIR=data/receipts

# Operator metrics at /admin (MRR, activation funnel, churn, retention, coupon management).
# Comma-separated emails. Empty means NOBODY is an admin, which is the safe default — the routes
# return 403 until you put your own address here. Read live from .env, so no restart needed.
ADMIN_EMAILS=

# Razorpay (paid plans, INR). Key id + secret enable checkout; read live from .env (no restart).
# Webhook: Dashboard -> Webhooks -> URL <APP_URL>/api/billing/webhook, events order.paid, payment.failed and
# (once Subscriptions is enabled) subscription.*,
# and the secret you set there goes in RAZORPAY_WEBHOOK_SECRET. Use rzp_test_ keys until your account is activated.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google sign-in: create an OAuth client ("Web application") at console.cloud.google.com
# and add  <APP_URL>/api/auth/google/callback  as an Authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- operations
# Reverse proxies in front of the API that append to X-Forwarded-For (Next.js = 1; add one per load balancer).
TRUSTED_PROXY_HOPS=1
# text | json (one JSON object per request, for log aggregators)
LOG_FORMAT=text
# Per-IP limits on sign-in, sign-up, demo and SMS forwarding. Leave on in production.
IP_RATE_LIMITS=on
